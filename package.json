{
  "name": "number-veil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n worker,web \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev --local --port 8787",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name number-veil",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "^10.4.20",
    "concurrently": "latest",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
